# DefectDojo Server Configuration
DEFECTDOJO_URL=http://localhost:8080

# DefectDojo API v2 Token (obtain via UI /api/key-v2 or: docker exec <uwsgi-container> python manage.py drf_create_token admin)
DEFECTDOJO_API_TOKEN=your_defectdojo_api_v2_token_here

# Target Product and Engagement Names
DEFECTDOJO_PRODUCT_NAME="Kubernetes Runtime Security Lab"
DEFECTDOJO_ENGAGEMENT_NAME="Container Image Vulnerability Scans"

# DefectDojo Admin Credentials (used during initial setup / password reset)
DEFECTDOJO_ADMIN_USER=admin
DEFECTDOJO_ADMIN_PASSWORD=your_defectdojo_admin_password_here

# Port Mapping (Important: on Windows Hyper-V, port 8443 is frequently reserved in excluded port ranges; use 9443 for TLS)
DD_PORT=8080
DD_TLS_PORT=9443
